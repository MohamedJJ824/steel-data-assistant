# Copy to .env and adjust. .env is gitignored; never commit real credentials.

# ----------------------------------------------------------------- database --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=steel
# 5433 on the host to avoid clashing with a local Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Role passwords, created by docker/db/init/04_roles.sh on first start.
# Changing these after the volume exists has no effect; run `make clean` first.
ASSISTANT_RO_PASSWORD=change-me-assistant-ro
APP_RW_PASSWORD=change-me-app-rw

# ---------------------------------------------------------------------- llm --
# backend: ollama | openai_compatible
SDA_LLM__BACKEND=ollama
SDA_LLM__BASE_URL=http://localhost:11434
SDA_LLM__API_KEY=
# On macOS, Docker has no Metal access: run Ollama natively on the host and
# point containers at http://host.docker.internal:11434 instead.

# ---------------------------------------------------------------------- api --
SDA_API__KEY=change-me-api-key

# ------------------------------------------------------------------- mlflow --
MLFLOW_TRACKING_URI=http://localhost:5000
